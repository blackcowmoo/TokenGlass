{
  "name": "tokenglass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:sidecar": "node scripts/prepare-codex-sidecar.mjs",
    "format": "biome format --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "biome format . && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "dev": "vite",
    "build": "pnpm prepare:sidecar && tsc && vite build",
    "build:windows-test": "node scripts/build-windows-test.mjs",
    "smoke:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-test.ps1",
    "test:windows-support": "cargo test --manifest-path src-tauri/Cargo.toml diagnostics",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "~2.4.4",
    "js-tiktoken": "^1.0.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
